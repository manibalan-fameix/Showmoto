# Copy to .env.local and fill in. Never commit real values.

# --- Core (Phase 1) ---
# Postgres connection string.
DATABASE_URL=postgres://user:password@localhost:5432/fameix
# Domain dealers' sites live under, without protocol. Dev: localhost:3000
# Dealer sites: <slug>.ROOT_DOMAIN, admin: app.ROOT_DOMAIN
ROOT_DOMAIN=localhost:3000
# Auth.js: generate with `openssl rand -base64 32`
AUTH_SECRET=
# Google OAuth client (redirect URI: http(s)://app.<ROOT_DOMAIN>/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 32 bytes, base64. Encrypts reg numbers, phones, RC responses. `openssl rand -base64 32`
# Losing this key makes encrypted data unreadable. Back it up separately from the database.
ENCRYPTION_KEY=

# --- Seed only ---
# Makes this Google account the owner of the first demo dealer.
SEED_OWNER_EMAIL=

# --- Later phases (not used yet) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
RC_PROVIDER=mock
RC_API_KEY=
VISION_API_KEY=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
RESEND_API_KEY=
SENTRY_DSN=
